# Бесплатная нейросеть для точного разбора постов (необязательно).
# Если ключа нет, система работает на правилах.
#
# Google Gemini (бесплатно, Узбекистан поддерживается):
#   1) откройте https://aistudio.google.com/apikey и войдите Google-аккаунтом
#   2) нажмите "Create API key" и скопируйте ключ
#   3) вставьте его в файл .env после LLM_API_KEY= (без пробелов и кавычек)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# модели перечислены через запятую: если у первой кончился лимит, берётся следующая
LLM_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# сколько постов отправлять за один запрос и пауза между запросами (сек)
LLM_BATCH=8
LLM_PAUSE=5
#
# Альтернатива — Groq (бесплатно): https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
